# Pooled connection (Supabase "Transaction pooler", port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements (required in transaction mode).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/session connection (Supabase "Session pooler", port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-your-own"

# Used once by `prisma db seed` to create the first admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Supabase Storage — Project Settings > API.
# Service role: server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
# Anon/public key: safe to expose to the browser (used only for direct-to-Storage
# uploads via signed URLs, e.g. banner video). Must be prefixed NEXT_PUBLIC_ to
# reach client components.
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-public-key"
