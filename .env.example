# Pooled connection (Supabase "Transaction pooler", port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements (required in transaction mode).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/session connection (Supabase "Session pooler", port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-your-own"

# Used once by `prisma db seed` to create the first admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Supabase Storage — Project Settings > API.
# Service role: server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
# Anon/public key: safe to expose to the browser (used only for direct-to-Storage
# uploads via signed URLs, e.g. banner video). Must be prefixed NEXT_PUBLIC_ to
# reach client components.
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-public-key"

# Resend (https://resend.com) — used to send password-reset and admin-invite
# emails. Without it, those flows still work but the email is only logged to
# the server console instead of actually delivered (invite links are also
# shown/copyable directly in the admin UI as a fallback).
RESEND_API_KEY="re_xxxxxxxx"
# Must be on a domain verified in Resend. Defaults to onboarding@resend.dev,
# which Resend only delivers to the account owner's own email — fine for
# testing, not for real users.
RESEND_FROM_EMAIL="naoresponda@seudominio.com.br"

# Public URL of the deployed site, used to build absolute links in emails.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL / localhost if unset.
NEXT_PUBLIC_APP_URL="https://arcoirismar-newsite.vercel.app"
