// Prisma schema — Arco-íris-mar
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  CORRETOR
}

/// Situação de aprovação do cadastro de corretor (CRECI validado manualmente pelo admin)
enum CorretorStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

enum EmpreendimentoStatus {
  EM_BREVE
  LANCAMENTO
  EM_OBRAS
  PRONTO
}

/// Onde o empreendimento aparece na home: só no Portfólio, ou no carrossel (e no Portfólio)
enum Destaque {
  NENHUM
  PORTFOLIO
  CARROSSEL
}

enum UnidadeStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
  BLOQUEADO
  /// Unidade decorada/showroom — aparece pro corretor sem valores, como Reservado
  DECORADO
  /// Unidade em negociação de troca de área — não aparece pro corretor, só no admin
  TROCA_AREA
}

enum ReservaStatus {
  ATIVA
  CANCELADA
  CONVERTIDA
  EXPIRADA
}

enum ReservaEventoTipo {
  CRIADA
  CANCELADA
  CONFIRMADA
  EXPIRADA
}

enum MidiaTipo {
  FOTO
  VIDEO
  PLANTA
}

enum SistemaAmortizacao {
  SAC
  PRICE
}

/// Como interpretar um valor do plano direto: percentual do preço ou valor fixo em R$
enum TipoValorPlano {
  PERCENTUAL
  FIXO
}

/// Quando uma condição de pagamento é cobrada — os dois tipos ATO_* são sempre 1x
/// (pagamento único); os demais são séries recorrentes de N parcelas.
enum PeriodicidadeCondicao {
  ATO_ASSINATURA
  ATO_ENTREGA_CHAVES
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// ---------------------------------------------------------------------------
// Autenticação (modelos exigidos pelo Auth.js / Prisma Adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Hash da senha (bcrypt/argon2) — usado pelo provider de credenciais do Auth.js
  password      String?

  role Role @default(CORRETOR)

  /// Chaves das páginas do admin liberadas para este usuário (ver src/lib/admin-paginas.ts) — só
  /// tem efeito para role=ADMIN; definido no convite, sem tela de edição por enquanto
  paginasPermitidas String[] @default([])

  // Campos específicos do cadastro de corretor
  telefone String?
  creci    String?
  status   CorretorStatus @default(PENDENTE)

  accounts Account[]
  sessions Session[]

  reservasComoCorretor Reserva[]       @relation("ReservaCorretor")
  reservaEventos       ReservaEvento[] @relation("ReservaEventoAutor")

  historicoPrecosAlterados         HistoricoPrecoUnidade[]                 @relation("HistoricoPrecoAutor")
  historicoStatusAlterados         HistoricoStatusUnidade[]                @relation("HistoricoStatusAutor")
  historicoPlanoPagamentoAlterados HistoricoPlanoPagamentoEmpreendimento[] @relation("HistoricoPlanoPagamentoAutor")
  configuracoesSimulacao           ConfiguracaoSimulacao[]                 @relation("ConfiguracaoSimulacaoAutor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Empreendimentos
// ---------------------------------------------------------------------------

model Empreendimento {
  id        String               @id @default(cuid())
  slug      String               @unique
  nome      String
  descricao String?              @db.Text
  status    EmpreendimentoStatus @default(EM_BREVE)

  /// Chamada usada no banner/hero (ex.: "Um novo conceito de morar frente ao mar")
  slogan         String?
  /// URL pública do logo do empreendimento (Supabase Storage) — usado no hero da home, ao lado do nome
  logoUrl        String?
  /// URL pública da imagem de banner (Supabase Storage) — usada no hero, no card do Portfólio e na página de detalhe
  bannerUrl      String?
  /// URL pública do vídeo de banner (Supabase Storage) — usada só no hero, substituindo a imagem quando presente
  bannerVideoUrl String?
  /// URL pública da imagem de capa da tabela de unidades (Supabase Storage) — usada como
  /// página de capa quando o corretor exporta a tabela para PDF
  capaTabelaUrl  String?

  // --- Conteúdo da exportação em PDF da tabela de unidades (área do corretor) ---
  /// HTML (rich text, pode conter imagens) exibido no topo de cada página da tabela
  tabelaCabecalhoHtml String? @db.Text
  /// HTML (rich text, pode conter imagens) exibido logo abaixo do cabeçalho, em cada página
  tabelaDescricaoHtml String? @db.Text
  /// HTML (rich text, pode conter imagens) exibido no rodapé de cada página da tabela
  tabelaRodapeHtml    String? @db.Text
  /// URL pública do PDF da tabela já gerado pelo admin (Supabase Storage) — é isso que o
  /// corretor acessa; não é gerado sob demanda na área do corretor
  tabelaPdfUrl        String?
  /// Quando o PDF da tabela foi gerado pela última vez (usado no rodapé do próprio PDF)
  tabelaPdfGeradoEm   DateTime?

  /// Link de biblioteca pública de mídia (Google Drive, OneDrive etc.) — visível só aos corretores
  linkMidiaPublica String?

  /// Controla onde o empreendimento aparece na home (ver enum Destaque)
  destaque Destaque @default(NENHUM)

  /// Quando true, aparece na página /admin/espelho-venda
  espelhoVenda Boolean @default(false)

  endereco  String?
  bairro    String?
  cidade    String?
  estado    String?
  cep       String?
  latitude  Float?
  longitude Float?

  entregaPrevista DateTime?

  // --- Geração de unidades em lote (todos opcionais: só exigidos pela ação "Gerar unidades") ---
  andares                 Int?
  unidadesPorAndar        Int?
  /// Preço aplicado a cada unidade recém-gerada (editável por unidade depois)
  valorBase               Decimal? @db.Decimal(12, 2)
  // Valores padrão opcionais aplicados às unidades geradas em lote (não cobertos pela especificação original)
  dormitoriosPadrao       Int?
  suitesPadrao            Int?
  areaPrivativaPadrao     Float?
  vagasPadrao             Int?

  unidades                Unidade[]
  midias                  Midia[]
  midiasExternas          MidiaExterna[]
  documentosAdicionais    DocumentoAdicional[]
  condicoesPagamento      CondicaoPagamentoEmpreendimento[]
  historicoPlanoPagamento HistoricoPlanoPagamentoEmpreendimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empreendimentos")
}

/// Histórico do plano de pagamento do empreendimento (valor base + lista de condições de
/// pagamento) — uma linha por salvamento que alterou pelo menos um desses campos, com o
/// snapshot completo de antes/depois. Somente admin.
model HistoricoPlanoPagamentoEmpreendimento {
  id               String @id @default(cuid())
  empreendimentoId String

  valorBaseAnterior Decimal? @db.Decimal(12, 2)
  valorBaseNovo     Decimal? @db.Decimal(12, 2)

  /// Snapshot completo da lista de condições de pagamento antes/depois desta mudança —
  /// array de { id, rotulo, periodicidade, quantidade, valor, tipoValor }
  condicoesAnteriores Json?
  condicoesNovas      Json?

  autorId String
  motivo  String?

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  autor          User           @relation("HistoricoPlanoPagamentoAutor", fields: [autorId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([empreendimentoId, criadoEm])
  @@map("historico_plano_pagamento_empreendimento")
}

/// Uma tranche do plano de pagamento direto do empreendimento (entrada, entrega das chaves,
/// parcelas mensais, semestrais etc.) — várias linhas por empreendimento, permitindo qualquer
/// combinação de séries recorrentes simultâneas.
model CondicaoPagamentoEmpreendimento {
  id               String @id @default(cuid())
  empreendimentoId String
  ordem            Int    @default(0)

  /// Rótulo customizado; quando nulo, a UI deriva um padrão de `periodicidade`
  rotulo String?

  periodicidade PeriodicidadeCondicao
  /// Sempre 1 para os dois tipos ATO_*; livre para os recorrentes
  quantidade    Int            @default(1)
  /// Valor de CADA parcela desta condição — percentual do preço da unidade ou R$ fixo.
  /// Nulo quando `restante` é true, já que nesse caso o valor é sempre calculado.
  valor         Decimal?       @db.Decimal(12, 2)
  tipoValor     TipoValorPlano @default(PERCENTUAL)
  /// Quando true, ignora `valor`/`tipoValor` e calcula o valor de cada parcela como
  /// (preço da unidade − soma das outras condições) / quantidade — pra planos onde
  /// entrada/chaves são valores fixos iguais para todas as unidades e o saldo (que
  /// varia por unidade) é diluído nas parcelas restantes.
  restante      Boolean        @default(false)

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empreendimentoId, ordem])
  @@map("condicoes_pagamento_empreendimento")
}

/// Galeria pública do empreendimento (fotos, vídeos, plantas)
model Midia {
  id               String    @id @default(cuid())
  empreendimentoId String
  tipo             MidiaTipo
  url              String
  titulo           String?
  ordem            Int       @default(0)
  /// Quando false, fica oculta em todo o sistema (ex.: planta ainda não pronta pra divulgar)
  publico          Boolean   @default(true)

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([empreendimentoId, tipo])
  @@map("midias")
}

/// Links externos (ex.: pasta de fotos em alta, materiais de divulgação) — visíveis somente na área do corretor
model MidiaExterna {
  id               String  @id @default(cuid())
  empreendimentoId String
  titulo           String
  url              String
  descricao        String?

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("midias_externas")
}

/// PDFs anexados à tabela de unidades (ex.: memorial descritivo, tabela de acabamentos) —
/// mesclados como páginas extras quando o corretor exporta a tabela para PDF
model DocumentoAdicional {
  id               String @id @default(cuid())
  empreendimentoId String
  titulo           String
  url              String
  ordem            Int    @default(0)

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([empreendimentoId])
  @@map("documentos_adicionais")
}

// ---------------------------------------------------------------------------
// Unidades
// ---------------------------------------------------------------------------

model Unidade {
  id               String @id @default(cuid())
  empreendimentoId String

  /// Identificador da unidade (ex.: "302", "Bloco A - 1201")
  identificador String
  /// Total de dormitórios, incluindo os que são suíte (ver campo `suites`)
  dormitorios   Int
  /// Quantos dos dormitórios são suíte — sempre <= dormitorios
  suites        Int @default(0)
  areaPrivativa Float
  vagas         Int    @default(0)
  /// Área da garagem — somada à área privativa e à área comum para compor a "Área Total" (não persistida, calculada na exibição)
  areaGaragem   Float  @default(0)
  /// Área comum — somada à área privativa e à área da garagem para compor a "Área Total" (não persistida, calculada na exibição)
  areaComum     Float  @default(0)
  andar         Int?

  preco  Decimal       @db.Decimal(12, 2)
  status UnidadeStatus @default(DISPONIVEL)

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  // Histórico — visível somente para admins na aplicação
  historicoPrecos HistoricoPrecoUnidade[]
  historicoStatus HistoricoStatusUnidade[]
  reservas        Reserva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empreendimentoId, identificador])
  @@index([empreendimentoId, status])
  @@map("unidades")
}

/// Histórico de alterações de preço de uma unidade — somente admin
model HistoricoPrecoUnidade {
  id            String  @id @default(cuid())
  unidadeId     String
  precoAnterior Decimal @db.Decimal(12, 2)
  precoNovo     Decimal @db.Decimal(12, 2)
  autorId       String
  motivo        String?

  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  autor   User    @relation("HistoricoPrecoAutor", fields: [autorId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([unidadeId, criadoEm])
  @@map("historico_precos_unidade")
}

/// Histórico de alterações de status de uma unidade — somente admin
model HistoricoStatusUnidade {
  id             String        @id @default(cuid())
  unidadeId      String
  statusAnterior UnidadeStatus
  statusNovo     UnidadeStatus
  autorId        String
  motivo         String?

  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  autor   User    @relation("HistoricoStatusAutor", fields: [autorId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([unidadeId, criadoEm])
  @@map("historico_status_unidade")
}

// ---------------------------------------------------------------------------
// Reservas
// ---------------------------------------------------------------------------

model Reserva {
  id         String @id @default(cuid())
  unidadeId  String
  corretorId String

  clienteNome     String
  clienteEmail    String?
  clienteTelefone String?

  status     ReservaStatus @default(ATIVA)
  observacao String?

  unidade  Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  corretor User    @relation("ReservaCorretor", fields: [corretorId], references: [id], onDelete: Restrict)

  // Histórico de eventos da reserva (criada, cancelada, confirmada...) — somente admin
  eventos ReservaEvento[]

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@index([unidadeId, status])
  @@index([corretorId, status])
  @@map("reservas")
}

/// Log de eventos do ciclo de vida de uma reserva — somente admin
model ReservaEvento {
  id         String            @id @default(cuid())
  reservaId  String
  tipo       ReservaEventoTipo
  autorId    String
  observacao String?

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  autor   User    @relation("ReservaEventoAutor", fields: [autorId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([reservaId, criadoEm])
  @@map("reserva_eventos")
}

// ---------------------------------------------------------------------------
// Configuração de simulação de financiamento
// ---------------------------------------------------------------------------

/// Cada alteração gera uma nova linha (a mais recente por criadoEm é a vigente) — dá histórico "de graça"
model ConfiguracaoSimulacao {
  id                      String             @id @default(cuid())
  taxaJurosAnual          Decimal            @db.Decimal(5, 2)
  prazoMaximoMeses        Int
  entradaMinimaPercentual Decimal            @db.Decimal(5, 2)
  sistemaAmortizacao      SistemaAmortizacao @default(SAC)

  autorId String
  autor   User   @relation("ConfiguracaoSimulacaoAutor", fields: [autorId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@map("configuracoes_simulacao")
}

// ---------------------------------------------------------------------------
// Conteúdo institucional da home (seção "Sobre" + Missão/Visão/Valores)
// ---------------------------------------------------------------------------

/// Linha única (singleton, id fixo) — conteúdo editável pelo admin exibido na home
model ConteudoSite {
  id String @id @default("conteudo-site")

  sobreTitulo    String
  sobreDescricao String  @db.Text
  sobreImagemUrl String?

  /// Mês/ano de fundação — usado para calcular "X anos de mercado" automaticamente
  fundacaoData DateTime

  /// Ex.: "Empreendimentos entregues" — editado manualmente, não é uma contagem automática
  stat2Valor  Int
  stat2Rotulo String

  /// Ex.: "Unidades entregues" — editado manualmente
  stat3Valor  Int
  stat3Rotulo String

  missaoTitulo    String
  missaoDescricao String  @db.Text
  missaoImagemUrl String?

  visaoTitulo    String
  visaoDescricao String  @db.Text
  visaoImagemUrl String?

  valoresTitulo    String
  valoresDescricao String  @db.Text
  valoresImagemUrl String?

  updatedAt DateTime @updatedAt

  @@map("conteudo_site")
}

// ---------------------------------------------------------------------------
// Revendas — unidades de terceiros recebidas como parte do pagamento
// ---------------------------------------------------------------------------

enum RevendaStatus {
  DISPONIVEL
  RESERVADA
  VENDIDA
}

/// Um dos 6 layouts visuais desenhados para a página de unidade de revenda no PDF —
/// ver src/lib/pdf/templates-revenda/. Nome do arquivo de origem entre parênteses.
enum TemplateRevenda {
  EDITORIAL   // mockup-editorial.html
  INFOGRAFICO // mockup-infographic.html
  BROCHURA    // mockup-brochure.html
  CARTAZ      // mockup-poster.html
  MOSAICO     // mockup-mosaic.html
  DUPLA       // mockup-duo.html
}

/// Unidade de terceiro recebida como pagamento e colocada à revenda. Não pertence
/// a nenhum Empreendimento (pode ser um apartamento de outro prédio, um sobrado,
/// uma casa), por isso é um modelo próprio e não uma Unidade.
model UnidadeRevenda {
  id String @id @default(cuid())

  /// Empreendimento ou tipo de construção (ex.: "Ed. Personalité", "Sobrado")
  nome          String
  /// Número da unidade — opcional, já que pode ser uma casa
  numeroUnidade String?
  valor         Decimal       @db.Decimal(12, 2)
  status        RevendaStatus @default(DISPONIVEL)

  /// Logradouro. `numeroEndereco` é o número da rua — não confundir com `numeroUnidade`.
  endereco       String?
  numeroEndereco String?
  cep            String?
  bairro         String?
  cidade         String?
  estado         String?
  latitude       Float?
  longitude      Float?

  /// Layout usado para gerar a página desta unidade no PDF
  template TemplateRevenda @default(EDITORIAL)

  /// Bloco/torre — opcional, ex.: "Torre A". Casas e a maioria das revendas ficam em branco.
  torre String?
  /// Frase curta de efeito, opcional — nem todo template exibe.
  tagline String? @db.Text

  // --- Ficha técnica: todos opcionais, cada um vira uma linha só se preenchido ---
  areaPrivativa   Decimal? @db.Decimal(8, 2)
  dormitorios     Int?
  suites          Int?
  vagas           Int?
  andar           String?
  elevadores      Int?
  /// Texto livre: ano futuro, "Pronto para morar" etc.
  entregaPrevista String?
  /// Ex.: "Sacada gourmet c/ churrasqueira"
  diferencial     String?

  descricao String? @db.Text

  /// Um item por linha — sem tabela de relação: é só uma lista curta editada em bloco.
  amenidades         String? @db.Text
  condicoesPagamento String? @db.Text
  localizacaoNota    String? @db.Text

  /// Substitui, na página da unidade, o rodapé padrão ("Interessado nesta unidade?" +
  /// contato do corretor + nome da construtora) — texto livre, com quebras de linha.
  informacoes String? @db.Text

  fotos FotoRevenda[]

  /// Ordem da página dentro do PDF — sem UI de reordenação por enquanto
  ordem Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("unidades_revenda")
}

/// Galeria ordenada de fotos de uma unidade de revenda — cada template consome quantas
/// fotos precisar, na ordem; posições sem foto caem no placeholder decorativo do template.
model FotoRevenda {
  id        String  @id @default(cuid())
  unidadeId String
  url       String
  legenda   String?
  ordem     Int     @default(0)

  unidade UnidadeRevenda @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([unidadeId, ordem])
  @@map("fotos_revenda")
}

/// Linha única (singleton, id fixo — mesmo padrão de ConteudoSite): o que vale para
/// a tabela de Revendas inteira, e não por unidade.
model ConfiguracaoRevenda {
  id String @id @default("configuracao-revenda")

  /// Imagem usada como página de capa do PDF
  capaTabelaUrl     String?
  /// Repositório público de mídia (Drive/OneDrive) exibido ao corretor
  linkMidiaPublica  String?
  tabelaPdfUrl      String?
  tabelaPdfGeradoEm DateTime?

  updatedAt DateTime @updatedAt

  @@map("configuracao_revenda")
}
